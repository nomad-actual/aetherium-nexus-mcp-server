MCP_SERVER_PORT=3000
MCP_SERVER_HOST=localhost
MCP_SERVER_CORS_ALLOWED_ORIGINS=127.0.0.1|localhost
MCP_SERVER_CORS_ALLOWED_HOSTS=127.0.0.1|localhost
MCP_SERVER_TITLE=Simply Lovely MCP Server
TOOL_CALL_TIMEOUT=30000                          # milliseconds, max time a tool call may run

# default is Los Angeles
DEFAULT_LOCATION_LAT=34.052235
DEFAULT_LOCATION_LON=-118.243683

TIMESERVER_HOST=time.nist.gov                    # can be nist.gov or ntp.ubuntu.com, etc or your own
TIMESERVER_PORT=123                              # default is 123
TIMESERVER_TIMEOUT=200                           # default is 200ms

LOCALE_REGION=en-US
LOCALE_UNITS=imperial                            # imperial or metric
LOCALE_MONTH=short                               # short, long, narrow (Jul, July, J)
LOCALE_SHOWWEEKDAY=true
IS_24_HOUR_TIME=false

SEARCH_HOST=                                     # primarily use searxng
SEARCH_TIMEOUT=10000                             # milliseconds
SEARCH_PAGE_CONTENT_LIMIT=5000                   # Cuts off the sentence just after this length
SEARCH_MAX_RESULTS=10

SCRAPER_CONTENT_LIMIT=100000                     # max length of scraped page content
SCRAPER_REQUEST_TIMEOUT=10000                    # milliseconds, per-page scrape budget (also sent to CRW as deadlineMs)
SCRAPER_BASIC_MIN_SCORE=20                       # minimum readability score for basic HTML
SCRAPER_BASIC_MIN_LENGTH=140                     # minimum readable content length
# CRW (Firecrawl-compatible) scraper - primary web scraper, falls back to basic HTML if unset
SCRAPER_CRW_HOST=                                     # e.g. http://localhost:3000 (self-hosted) or https://api.fastcrw.com (hosted)
SCRAPER_CRW_API_KEY=                                   # only needed for the hosted API, not self-hosted
SCRAPER_CRW_RENDER_JS=                                 # leave empty for auto-detect, or true / false
SCRAPER_CRW_ONLY_MAIN_CONTENT=true                     # strip nav/footer/boilerplate before conversion
