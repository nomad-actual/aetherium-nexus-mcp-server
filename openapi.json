{
  "openapi": "3.0.3",
  "info": {
    "title": "aetherium-nexus",
    "version": "1.0.0",
    "description": "Aetherium Nexus MCP Server — exposes MCP tools via Streamable HTTP transport. The server is stateless: each POST /mcp request creates a fresh server + transport instance, so no session management is required."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server (default port 3000, configurable via MCP_SERVER_PORT / MCP_SERVER_HOST)"
    }
  ],
  "paths": {
    "/mcp": {
      "post": {
        "summary": "MCP Request",
        "description": "Handle MCP JSON-RPC 2.0 requests via Streamable HTTP transport. Supported methods: `initialize`, `notifications/initialized`, `ping`, `tools/list`, and `tools/call` (all 6 tools are invoked through `tools/call`). A single JSON-RPC message or a batch (array) of messages is accepted. The `Accept` header MUST list both `application/json` and `text/event-stream`, and `Content-Type` MUST be `application/json`. Responses may be returned as `application/json` or as a `text/event-stream` stream of JSON-RPC messages.",
        "operationId": "postMcpRequest",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "description": "MUST include both `application/json` and `text/event-stream`. Missing or incomplete values return 406.",
            "schema": {
              "type": "string",
              "example": "application/json, text/event-stream"
            }
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": true,
            "description": "MUST be `application/json`. Other values return 415.",
            "schema": {
              "type": "string",
              "enum": ["application/json"]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  { "$ref": "#/components/schemas/JSONRPCMessage" },
                  {
                    "type": "array",
                    "description": "JSON-RPC batch: an array of messages",
                    "minItems": 1,
                    "items": { "$ref": "#/components/schemas/JSONRPCMessage" }
                  }
                ]
              },
              "examples": {
                "initialize": {
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 1,
                    "method": "initialize",
                    "params": {
                      "protocolVersion": "2025-06-18",
                      "capabilities": {},
                      "clientInfo": { "name": "client", "version": "1.0.0" }
                    }
                  }
                },
                "tools-list": {
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 2,
                    "method": "tools/list"
                  }
                },
                "fetch-current-weather": {
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 3,
                    "method": "tools/call",
                    "params": {
                      "name": "fetch-current-weather",
                      "arguments": {
                        "location": "New York"
                      }
                    }
                  }
                },
                "fetch-weather-forecast": {
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 4,
                    "method": "tools/call",
                    "params": {
                      "name": "fetch-weather-forecast",
                      "arguments": {
                        "location": "London"
                      }
                    }
                  }
                },
                "fetch-current-time": {
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 5,
                    "method": "tools/call",
                    "params": {
                      "name": "fetch-current-time",
                      "arguments": {}
                    }
                  }
                },
                "web-search": {
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 6,
                    "method": "tools/call",
                    "params": {
                      "name": "web-search",
                      "arguments": {
                        "query": "latest AI news"
                      }
                    }
                  }
                },
                "track-package": {
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 7,
                    "method": "tools/call",
                    "params": {
                      "name": "track-package",
                      "arguments": {
                        "packages": ["1Z999AA10123456784"]
                      }
                    }
                  }
                },
                "scrape-website": {
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 8,
                    "method": "tools/call",
                    "params": {
                      "name": "scrape-website",
                      "arguments": {
                        "url": "https://example.com/article"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response. Success responses carry `result` (shape depends on the method: `CallToolResult` for tools/call, `ListToolsResult` for tools/list, `InitializeResult` for initialize, empty object for ping). Protocol errors (e.g. -32601 method not found, -32700 parse error) are returned with HTTP 200 and an `error` object. Note: tool execution failures AND input validation failures are NOT JSON-RPC errors — they return 200 with `result.isError: true` and the error message in `content`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JSONRPCResponse"
                }
              },
              "text/event-stream": {
                "description": "The server may stream responses as Server-Sent Events. Each `message` event's `data` field contains one JSON-RPC response.",
                "schema": {
                  "$ref": "#/components/schemas/JSONRPCResponse"
                }
              }
            }
          },
          "202": {
            "description": "Accepted with an empty body. Returned for notifications (e.g. `notifications/initialized`), which carry no response."
          },
          "400": {
            "description": "Bad Request — invalid JSON (returned as an HTML error page by the JSON body parser), invalid JSON-RPC message, or unsupported MCP protocol version (both the latter two as JSON-RPC error bodies).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "text/html": {
                "description": "HTML error page returned when the request body is not valid JSON."
              }
            }
          },
          "406": {
            "description": "Not Acceptable — the `Accept` header must list both `application/json` and `text/event-stream`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type — `Content-Type` must be `application/json`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error — an uncaught error while handling the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Not allowed",
        "description": "GET requests to /mcp are not supported (SSE notifications are not used in stateless mode) and return 405 Method Not Allowed with a JSON-RPC error body.",
        "responses": {
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Not allowed",
        "description": "DELETE requests to /mcp are not supported (session termination is not needed in stateless mode) and return 405 Method Not Allowed with a JSON-RPC error body.",
        "responses": {
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns server health and process uptime in seconds.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Server is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok"]
                    },
                    "uptime": {
                      "type": "number",
                      "description": "Process uptime in seconds"
                    }
                  },
                  "required": ["status", "uptime"]
                },
                "example": {
                  "status": "ok",
                  "uptime": 123.456
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "JSONRPCMessage": {
        "type": "object",
        "description": "A single JSON-RPC 2.0 message (request or notification).",
        "properties": {
          "jsonrpc": {
            "type": "string",
            "enum": ["2.0"],
            "description": "JSON-RPC protocol version"
          },
          "id": {
            "type": ["string", "integer"],
            "description": "Request identifier. Omitted for notifications (e.g. notifications/initialized)."
          },
          "method": {
            "type": "string",
            "enum": ["initialize", "notifications/initialized", "ping", "tools/list", "tools/call"],
            "description": "MCP method to invoke"
          },
          "params": {
            "description": "Method-specific parameters. Shape depends on the method; omitted for notifications.",
            "oneOf": [
              { "$ref": "#/components/schemas/ToolCallParams" },
              { "$ref": "#/components/schemas/InitializeParams" },
              { "$ref": "#/components/schemas/EmptyParams" }
            ]
          }
        },
        "required": ["jsonrpc", "method"]
      },
      "JSONRPCResponse": {
        "type": "object",
        "description": "A JSON-RPC 2.0 response. Exactly one of `result` or `error` is present.",
        "properties": {
          "jsonrpc": {
            "type": "string",
            "enum": ["2.0"]
          },
          "id": {
            "type": ["string", "integer", "null"],
            "description": "The id of the request this responds to. null for errors that could not be associated with a request (e.g. parse errors)."
          },
          "result": {
            "description": "Present on success. Shape depends on the method: CallToolResult (tools/call), ListToolsResult (tools/list), InitializeResult (initialize), empty object (ping).",
            "type": "object"
          },
          "error": {
            "$ref": "#/components/schemas/JSONRPCError"
          }
        },
        "required": ["jsonrpc", "id"],
        "oneOf": [
          { "required": ["result"] },
          { "required": ["error"] }
        ]
      },
      "JSONRPCError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "JSON-RPC error code (e.g. -32700 parse error, -32600 invalid request, -32601 method not found, -32602 invalid params, -32603 internal error)"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "description": "Optional error details"
          }
        },
        "required": ["code", "message"]
      },
      "ToolCallParams": {
        "type": "object",
        "description": "Parameters for the tools/call method.",
        "properties": {
          "name": {
            "type": "string",
            "enum": ["fetch-current-weather", "fetch-weather-forecast", "fetch-current-time", "web-search", "track-package", "scrape-website"],
            "description": "Tool name to call"
          },
          "arguments": {
            "description": "Tool-specific input arguments. Optional; must match the selected tool's input schema.",
            "anyOf": [
              { "$ref": "#/components/schemas/FetchCurrentWeatherInput" },
              { "$ref": "#/components/schemas/FetchWeatherForecastInput" },
              { "$ref": "#/components/schemas/FetchCurrentTimeInput" },
              { "$ref": "#/components/schemas/WebSearchInput" },
              { "$ref": "#/components/schemas/TrackPackageInput" },
              { "$ref": "#/components/schemas/ScrapeWebsiteInput" }
            ]
          }
        },
        "required": ["name"]
      },
      "InitializeParams": {
        "type": "object",
        "description": "Parameters for the initialize method.",
        "properties": {
          "protocolVersion": {
            "type": "string",
            "description": "The MCP protocol version the client wants to use (e.g. 2025-06-18)"
          },
          "capabilities": {
            "type": "object",
            "description": "Capabilities the client supports"
          },
          "clientInfo": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" }
            },
            "required": ["name", "version"]
          }
        },
        "required": ["protocolVersion", "capabilities", "clientInfo"]
      },
      "EmptyParams": {
        "type": "object",
        "description": "No parameters (tools/list, ping, notifications/initialized)."
      },
      "InitializeResult": {
        "type": "object",
        "description": "Result of the initialize method.",
        "properties": {
          "protocolVersion": {
            "type": "string",
            "description": "The protocol version the server will use"
          },
          "capabilities": {
            "type": "object",
            "description": "Capabilities the server supports (this server: tools only)"
          },
          "serverInfo": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Server name (MCP_SERVER_TITLE, default 'Aetherium Nexus MCP Server')"
              },
              "version": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": ["name", "version"]
          }
        },
        "required": ["protocolVersion", "capabilities", "serverInfo"]
      },
      "ListToolsResult": {
        "type": "object",
        "description": "Result of the tools/list method.",
        "properties": {
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": "string" },
                "inputSchema": {
                  "type": "object",
                  "description": "JSON Schema for the tool's input arguments"
                },
                "annotations": {
                  "type": "object",
                  "description": "Tool annotations (title, readOnlyHint, openWorldHint)"
                }
              },
              "required": ["name", "inputSchema"]
            }
          }
        },
        "required": ["tools"]
      },
      "CallToolResult": {
        "type": "object",
        "description": "Result of a tools/call request.",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentItem"
            }
          },
          "isError": {
            "type": "boolean",
            "description": "True when the tool execution failed. The error message is returned in `content` (as text) and the HTTP status is still 200."
          }
        },
        "required": ["content"]
      },
      "ContentItem": {
        "oneOf": [
          {
            "type": "object",
            "description": "Text content",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["text"]
              },
              "text": {
                "type": "string",
                "description": "The text content"
              }
            },
            "required": ["type", "text"]
          },
          {
            "type": "object",
            "description": "Image content",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["image"]
              },
              "data": {
                "type": "string",
                "description": "Base64-encoded image data"
              },
              "mimeType": {
                "type": "string",
                "description": "MIME type of the image",
                "enum": ["image/png"]
              },
              "annotations": {
                "type": "object",
                "properties": {
                  "audience": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "priority": {
                    "type": "number"
                  }
                }
              }
            },
            "required": ["type", "data", "mimeType"]
          }
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "JSON-RPC error response returned by the transport for HTTP-level failures (400, 405, 406, 415, 500).",
        "properties": {
          "jsonrpc": {
            "type": "string",
            "enum": ["2.0"]
          },
          "error": {
            "$ref": "#/components/schemas/JSONRPCError"
          },
          "id": {
            "type": ["integer", "null"]
          }
        },
        "required": ["jsonrpc", "error", "id"]
      },
      "FetchCurrentWeatherInput": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "description": "Location to search for current weather"
          }
        }
      },
      "FetchWeatherForecastInput": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "description": "Location to search for weather forecast"
          }
        }
      },
      "FetchCurrentTimeInput": {
        "type": "object",
        "properties": {}
      },
      "WebSearchInput": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "The query that will be used to search against",
            "minLength": 1
          }
        },
        "required": ["query"]
      },
      "TrackPackageInput": {
        "type": "object",
        "properties": {
          "packages": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A tracking number",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Array of tracking numbers (at least one). The server tracks up to 20 packages per call; providing more returns a text notice instead of a validation error."
          }
        },
        "required": ["packages"]
      },
      "ScrapeWebsiteInput": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The url to scrape",
            "minLength": 1
          }
        },
        "required": ["url"]
      }
    }
  }
}
